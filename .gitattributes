# 统一换行符：仓库内一律 LF，避免 Windows / Linux 混用导致脚本在服务器上跑不起来
* text=auto eol=lf

# 需要保持原样的二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary

# Windows 批处理必须是 CRLF，否则双击可能闪退
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须是 LF，否则在 Ubuntu 上会报 $'\r': command not found
*.sh text eol=lf

# PowerShell 脚本用 CRLF 更稳
*.ps1 text eol=crlf
